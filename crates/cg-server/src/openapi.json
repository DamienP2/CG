        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [
     "Users & API keys"
    ],
    "summary": "Create an API key",
    "description": "The `secret` is returned **once**: use it as `Authorization: Bearer pcg_…`. The key acts with the rights of its user (create a dedicated operator account for automation).\n\n**Rights:** admin for any user; designers and operators for themselves.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "name"
        ],
        "properties": {
         "name": {
          "type": "string",
          "example": "Companion régie A"
         },
         "userId": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "key": {
           "$ref": "#/components/schemas/ApiKey"
          },
          "secret": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/api/keys/{id}": {
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "delete": {
    "tags": [
     "Users & API keys"
    ],
    "summary": "Revoke an API key",
    "description": "**Rights:** admin or the key's user.",
    "responses": {
     "204": {
      "description": "Done"
     }
    }
   }
  },
