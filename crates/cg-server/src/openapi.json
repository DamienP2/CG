{
 "openapi": "3.1.0",
 "info": {
  "title": "Pulse CG API",
  "version": "0.0.0",
  "description": "Everything the web app does goes through this API: automation systems (Companion / Stream Deck, newsroom MOS gateways, sports data feeds) have the same power as the UI.\n\n**Authentication**: `Authorization: Bearer <API key>` (create one in *Users → API keys*), or the `cg_session` cookie of the web app.\n\n**Real time**: `GET /ws` (WebSocket) pushes `hello`, `project`, `projectDeleted`, `channels` and `channel` events, and accepts `{\"type\":\"command\",\"channelId\":\"main\",\"command\":{…}}`. `/ws?channel=<id>` follows one channel (HTML5 output pages; public when *public outputs* is on).\n\nUnits: frames are project frames; times are Unix milliseconds."
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "bearer": []
  },
  {
   "cookie": []
  }
 ],
 "tags": [
  {
   "name": "Authentication"
  },
  {
   "name": "Users & API keys"
  },
  {
   "name": "Projects"
  },
  {
   "name": "Channels & playout"
  },
  {
   "name": "Assets"
  },
  {
   "name": "System"
  },
  {
   "name": "Updates"
  }
 ],
 "paths": {
  "/api/auth/state": {
   "get": {
    "tags": [
     "Authentication"
    ],
    "summary": "Who am I",
    "description": "Public.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "needsSetup": {
           "type": "boolean"
          },
          "user": {
           "oneOf": [
            {
             "$ref": "#/components/schemas/User"
            },
            {
             "type": "null"
            }
           ]
          },
          "serverName": {
           "type": "string"
          },
          "publicOutputs": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    },
    "security": []
   }
  },
  "/api/auth/login": {
   "post": {
    "tags": [
     "Authentication"
    ],
    "summary": "Log in",
    "description": "Sets the `cg_session` cookie and returns a session token (14 days, lost when the server restarts). For automation prefer an API key.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "username",
         "password"
        ],
        "properties": {
         "username": {
          "type": "string"
         },
         "password": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "user": {
           "$ref": "#/components/schemas/User"
          },
          "token": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Wrong user name or password"
     }
    },
    "security": []
   }
  },
  "/api/auth/logout": {
   "post": {
    "tags": [
     "Authentication"
    ],
    "summary": "Log out",
    "responses": {
     "204": {
      "description": "Done"
     }
    }
   }
  },
  "/api/auth/setup": {
   "post": {
    "tags": [
     "Authentication"
    ],
    "summary": "Create the first admin",
    "description": "Only while no user exists, and only from the server itself (loopback).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "username": {
          "type": "string"
         },
         "password": {
          "type": "string"
         },
         "displayName": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "security": []
   }
  },
