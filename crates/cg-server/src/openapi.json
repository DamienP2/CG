    "responses": {
     "202": {
      "description": "Restarting"
     }
    }
   }
  },
  "/api/system/update": {
   "get": {
    "tags": [
     "Updates"
    ],
    "summary": "Update status",
    "description": "**Rights:** admin.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UpdateInfo"
        }
       }
      }
     }
    }
   }
  },
  "/api/system/update/settings": {
   "put": {
    "tags": [
     "Updates"
    ],
    "summary": "Update source",
    "description": "**Rights:** admin.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "repo": {
          "type": "string"
         },
         "token": {
          "type": [
           "string",
           "null"
          ],
          "description": "null keeps the stored token, \"\" removes it."
         },
         "autoCheck": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "responses": {
