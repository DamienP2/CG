   }
  },
  "/api/system/update/check": {
   "post": {
    "tags": [
     "Updates"
    ],
    "summary": "Look for the latest release",
    "description": "**Rights:** admin.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Release"
        }
       }
      }
     }
    }
   }
  },
  "/api/system/update/install": {
   "post": {
    "tags": [
     "Updates"
    ],
    "summary": "Download and install the latest release",
    "description": "Runs in the background; follow `GET /api/system/update`. The server restarts.\n\n**Rights:** admin.",
    "responses": {
     "202": {
      "description": "Started"
     }
    }
   }
  },
  "/api/system/update/upload": {
   "post": {
    "tags": [
     "Updates"
    ],
    "summary": "Install an uploaded release archive",
    "description": "Body: the `pulse-cg-<version>-<platform>` .tar.gz / .zip. The server restarts.\n\n**Rights:** admin.",
    "parameters": [
     {
      "name": "allowOlder",
      "in": "query",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/octet-stream": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "version": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/api/system/update/rollback": {
   "post": {
    "tags": [
     "Updates"
    ],
    "summary": "Go back to the previous version",
    "description": "**Rights:** admin.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "version": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/api/projects/{id}/playlists": {
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "put": {
    "tags": [
     "Projects"
    ],
    "summary": "Replace the playlists (rundown sections)",
    "description": "Items of a removed playlist move to the first one.\n\n**Rights:** admin, designer, operator.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Playlist"
        }
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Done"
     }
    }
   }
  },
  "/api/projects/{id}/formats": {
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "put": {
    "tags": [
     "Projects"
    ],
    "summary": "Replace the alternative formats",
    "description": "Removing a format drops its layer overrides. The web designer lays every template out automatically when a format is added.\n\n**Rights:** admin, designer.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Format"
        }
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Done"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "API key (pcg_…) or session token"
   },
   "cookie": {
    "type": "apiKey",
    "in": "cookie",
    "name": "cg_session"
   }
  },
  "schemas": {
   "Error": {
    "type": "string",
    "description": "Plain-text message (HTTP 4xx/5xx)."
   },
   "FrameRate": {
    "type": "object",
    "required": [
     "num",
     "den"
    ],
    "properties": {
     "num": {
      "type": "integer",
      "example": 50
     },
     "den": {
      "type": "integer",
      "example": 1
     }
    }
   },
   "Data": {
    "type": "object",
    "additionalProperties": {
     "type": "string"
    },
    "description": "Template field values by key.",
    "example": {
     "name": "Ada Lovelace",
     "title": "Mathematician"
    }
   },
   "Role": {
    "type": "string",
    "enum": [
     "admin",
     "designer",
     "operator",
     "viewer"
    ]
   },
   "User": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "username": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     },
     "role": {
      "$ref": "#/components/schemas/Role"
     },
     "projects": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      },
      "description": "Project scope; null = all."
     },
     "channels": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      },
      "description": "Channel scope; null = all."
     },
     "disabled": {
      "type": "boolean"
     }
    }
   },
   "UserInput": {
    "type": "object",
    "required": [
     "username",
     "role"
    ],
    "properties": {
     "username": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     },
     "role": {
      "$ref": "#/components/schemas/Role"
     },
     "projects": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "channels": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "disabled": {
      "type": "boolean"
     },
     "password": {
      "type": "string",
      "description": "Required on creation (8+ characters); empty keeps the current one on edit."
     }
    }
   },
   "ApiKey": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "userId": {
      "type": "string"
     },
     "prefix": {
      "type": "string",
      "example": "pcg_3f9a2c"
     },
     "createdAt": {
      "type": "integer",
      "description": "Unix ms"
     },
     "lastUsed": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   "Zone": {
    "type": "object",
    "required": [
     "id",
     "name",
     "layer"
    ],
    "properties": {
     "id": {
      "type": "string",
      "example": "lower-third"
     },
     "name": {
      "type": "string",
      "example": "Lower third"
     },
     "layer": {
      "type": "integer",
      "description": "Stacking order (higher = in front); also the playout layer.",
      "example": 10
     },
     "color": {
      "type": "string",
      "example": "#7c5cff"
     },
     "transition": {
      "type": "string",
      "enum": [
       "sequential",
       "cut"
      ],
      "description": "sequential: the graphic on air goes out before the new one comes in."
     }
    }
   },
   "RundownItem": {
    "type": "object",
    "required": [
     "id",
     "name",
     "templateId"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "templateId": {
      "type": "string"
     },
     "zone": {
      "type": "string",
      "description": "Zone id; empty = the template's zone."
     },
     "playlist": {
      "type": "string"
     },
     "layer": {
      "type": "integer",
      "deprecated": true
     },
     "data": {
      "$ref": "#/components/schemas/Data"
     }
    }
   },
   "Template": {
    "type": "object",
    "description": "A graphic: timeline (frames), markers, data fields and layers. See web/src/engine/types.ts for the full layer model.",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "duration": {
      "type": "number"
     },
     "zone": {
      "type": "string"
     },
     "markers": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "frame": {
         "type": "number"
        },
        "name": {
         "type": "string"
        },
        "kind": {
         "type": "string",
         "enum": [
          "pause",
          "out",
          "label"
         ]
        }
       }
      }
     },
     "fields": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "kind": {
         "type": "string",
         "enum": [
          "text",
          "multiline",
          "number",
          "color",
          "image"
         ]
        },
        "default": {
         "type": "string"
        }
       }
      }
     },
     "layers": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     }
    }
   },
   "Project": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     },
     "frameRate": {
      "$ref": "#/components/schemas/FrameRate"
     },
     "templates": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Template"
      }
     },
     "rundown": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/RundownItem"
      }
     },
     "zones": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Zone"
      }
     },
     "playlists": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Playlist"
      }
     },
     "formats": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Format"
      }
     }
    }
   },
   "ProjectSummary": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     },
     "frameRate": {
      "$ref": "#/components/schemas/FrameRate"
     },
     "templates": {
      "type": "integer"
     },
     "rundown": {
      "type": "integer"
     }
    }
   },
   "ChannelInfo": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "example": "main"
     },
     "name": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     },
     "frameRate": {
      "$ref": "#/components/schemas/FrameRate"
     },
     "projectId": {
      "type": [
       "string",
       "null"
      ]
     },
     "outputs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "renditions": {
      "type": "array",
      "description": "Other pictures of the channel (9:16…), driven by the same takes; HTML5 at /output/<channel>/<rendition>.",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "width": {
         "type": "integer"
        },
        "height": {
         "type": "integer"
        }
       }
      }
     }
    }
   },
   "PlayoutItem": {
    "type": "object",
    "properties": {
     "templateId": {
      "type": "string"
     },
     "data": {
      "$ref": "#/components/schemas/Data"
     },
     "frame": {
      "type": "number"
     },
     "target": {
      "type": "number"
     },
     "phase": {
      "type": "string",
      "enum": [
       "playing",
       "holding",
       "out"
      ]
     },
     "rundownId": {
      "type": [
       "string",
       "null"
      ]
     },
     "age": {
      "type": "number",
      "description": "Project frames on air since the take."
     },
     "next": {
      "type": [
       "object",
       "null"
      ],
      "description": "Take waiting for this graphic to go out (sequential zones)."
     }
    }
   },
   "ChannelState": {
    "type": "object",
    "properties": {
     "layers": {
      "type": "object",
      "description": "Playout layer (zone stacking order) → graphic on air.",
      "additionalProperties": {
       "$ref": "#/components/schemas/PlayoutItem"
      }
     }
    }
   },
   "Command": {
    "type": "object",
    "required": [
     "action"
    ],
    "description": "Target a zone by id (`zone`) or a raw playout layer (`layer`). A take without either plays in the template's zone; a clear without either clears everything.",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "take",
       "continue",
       "takeOut",
       "update",
       "clear"
      ]
     },
     "zone": {
      "type": "string"
     },
     "layer": {
      "type": "integer"
     },
     "templateId": {
      "type": "string",
      "description": "take"
     },
     "data": {
      "$ref": "#/components/schemas/Data"
     },
     "rundownId": {
      "type": "string",
      "description": "take: rundown item, for tally"
     }
    },
    "example": {
     "action": "take",
     "zone": "lower-third",
     "templateId": "lower-third",
     "data": {
      "name": "Ada Lovelace"
     }
    }
   },
   "Release": {
    "type": "object",
    "properties": {
     "version": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "publishedAt": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "assetName": {
      "type": "string"
     },
     "size": {
      "type": "integer"
     },
     "digest": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "UpdateInfo": {
    "type": "object",
    "properties": {
     "current": {
      "type": "string"
     },
     "platform": {
      "type": "string"
     },
     "repo": {
      "type": "string"
     },
     "hasToken": {
      "type": "boolean"
     },
     "autoCheck": {
      "type": "boolean"
     },
     "previous": {
      "type": [
       "string",
       "null"
      ]
     },
     "history": {
      "type": [
       "object",
       "null"
      ]
     },
     "supervised": {
      "type": "boolean"
     },
     "status": {
      "type": "object",
      "properties": {
       "phase": {
        "type": "string",
        "enum": [
         "idle",
         "checking",
         "downloading",
         "installing",
         "restarting",
         "error"
        ]
       },
       "progress": {
        "type": "number"
       },
       "message": {
        "type": "string"
       },
       "latest": {
        "$ref": "#/components/schemas/Release"
       },
       "lastCheck": {
        "type": [
         "integer",
         "null"
        ]
       }
      }
     }
    }
   },
   "ServerConfig": {
    "type": "object",
    "description": "config.json: name, bind, publicOutputs, timezone and channels (format, outputs, loaded project).",
    "additionalProperties": true
   },
   "Playlist": {
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    }
   },
   "Format": {
    "type": "object",
    "required": [
     "id",
     "name",
     "width",
     "height"
    ],
    "description": "Alternative layout of a project (the main one is the project's width × height, id \"main\"). Layers carry per-format overrides; each output uses the format closest to its aspect ratio.",
    "properties": {
     "id": {
      "type": "string",
      "example": "vertical"
     },
