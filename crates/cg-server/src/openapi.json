  "/api/system": {
   "get": {
    "tags": [
     "System"
    ],
    "summary": "Server information",
    "description": "`config` is only filled for admins.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true
        }
       }
      }
     }
    }
   }
  },
  "/api/system/config": {
   "put": {
    "tags": [
     "System"
    ],
    "summary": "Save settings and restart the engine",
    "description": "**Rights:** admin.",
