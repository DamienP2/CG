  "/api/keys": {
   "get": {
    "tags": [
     "Users & API keys"
    ],
    "summary": "List API keys",
    "description": "Admins see every key, others their own.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ApiKey"
