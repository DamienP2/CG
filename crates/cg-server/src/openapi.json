     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ServerConfig"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "Restarting"
     }
    }
   }
  },
  "/api/system/restart": {
   "post": {
    "tags": [
     "System"
    ],
    "summary": "Restart the engine",
