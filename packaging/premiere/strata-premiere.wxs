<?xml version="1.0" encoding="utf-8"?>
<!--
  Strata panel for Premiere Pro — Windows Installer package (WiX Toolset v5).
  Installs for the current user (no admin rights), in the user's CEP folder,
  where the panel can update itself from the Strata server.
  Build: packaging/premiere/stage.sh <dir>, then
         wix build strata-premiere.wxs -ext WixToolset.Util.wixext -sval
         -d Version=0.1.0 -d PanelDir=<dir>\io.pulsecg.premiere -d DocsDir=<repo root> -o Strata-Premiere.msi
  Silent install with the server set: msiexec /i Strata-Premiere.msi /qn SERVER=http://cg-server:8080
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Strata for Premiere Pro"
           Manufacturer="Strata"
           Version="$(var.Version)"
           UpgradeCode="5f0d3a2e-8c41-4b6e-9a57-2d7c1e9b4f63"
           Scope="perUser"
           Codepage="1252"
           Compressed="yes">
    <SummaryInformation Description="Strata panel for Adobe Premiere Pro" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de [ProductName] est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Strata server the panel starts on (msiexec SERVER=...); empty: asked in the panel. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="Strata.ico" SourceFile="$(var.DocsDir)\assets\icons\pulse-cg.ico" />
    <Property Id="ARPPRODUCTICON" Value="Strata.ico" />

    <!-- The panel adds files when it updates itself: remove the whole folder on uninstall. -->
    <Property Id="EXTDIR">
      <RegistrySearch Root="HKCU" Key="Software\Strata\Premiere" Name="Folder" Type="raw" />
    </Property>

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AdobeDir" Name="Adobe">
        <Directory Id="CepDir" Name="CEP">
          <Directory Id="ExtensionsDir" Name="extensions">
            <Directory Id="EXT" Name="io.pulsecg.premiere" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Panel" Directory="EXT">
      <Files Include="$(var.PanelDir)\**" />
      <Component Id="PanelSetup">
        <RegistryValue Root="HKCU" Key="Software\Strata\Premiere" Name="Folder" Value="[EXT]" Type="string" KeyPath="yes" />
        <!-- The panel is not signed by Adobe Exchange: allow unsigned extensions. -->
        <RegistryValue Root="HKCU" Key="Software\Adobe\CSXS.9" Name="PlayerDebugMode" Value="1" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Adobe\CSXS.10" Name="PlayerDebugMode" Value="1" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Adobe\CSXS.11" Name="PlayerDebugMode" Value="1" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Adobe\CSXS.12" Name="PlayerDebugMode" Value="1" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Adobe\CSXS.13" Name="PlayerDebugMode" Value="1" Type="string" />
        <util:RemoveFolderEx On="uninstall" Property="EXTDIR" />
        <RemoveFolder Id="RemoveExtensionsDir" Directory="ExtensionsDir" On="uninstall" />
        <RemoveFolder Id="RemoveCepDir" Directory="CepDir" On="uninstall" />
        <RemoveFolder Id="RemoveAdobeDir" Directory="AdobeDir" On="uninstall" />
      </Component>
      <Component Id="PanelServer" Condition="SERVER">
        <RegistryValue Root="HKCU" Key="Software\Strata\Premiere" Name="Server" Value="[SERVER]" Type="string" KeyPath="yes" />
        <IniFile Id="StrataIni" Name="strata.ini" Directory="EXT" Section="strata" Key="server" Value="[SERVER]" Action="addLine" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="Panel" />
    </Feature>
  </Package>
</Wix>
