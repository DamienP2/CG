#!/bin/sh
# "Uninstall Strata Graphics.app" — asks for confirmation, then runs the uninstall
# script with administrator rights (the macOS password prompt).
SCRIPT=/usr/local/pulse-cg/uninstall.sh
ICON="$(cd "$(dirname "$0")/../Resources" && pwd)/AppIcon.icns"

case "$(defaults read -g AppleLanguages 2>/dev/null | sed -n 2p | tr -d ' ",')" in
  fr*)
    TITLE="Désinstaller Strata Graphics"
    ASK="Le serveur Strata Graphics, l'application de la barre des menus et ce désinstallateur vont être supprimés.

Faut-il aussi supprimer vos données (templates, rundown, médias et réglages) ?"
    CANCEL="Annuler"; KEEP="Garder mes données"; PURGE="Tout supprimer"
    DONE="Strata Graphics a été désinstallé."
    MISSING="Strata Graphics n'est pas installé sur ce Mac."
    FAILED="La désinstallation a échoué :" ;;
  *)
    TITLE="Uninstall Strata Graphics"
    ASK="The Strata Graphics server, the menu bar app and this uninstaller will be removed.

Do you also want to delete your data (templates, rundown, media and settings)?"
    CANCEL="Cancel"; KEEP="Keep my data"; PURGE="Delete everything"
    DONE="Strata Graphics has been uninstalled."
    MISSING="Strata Graphics is not installed on this Mac."
    FAILED="Uninstall failed:" ;;
esac

dialog() { # message, buttons (AppleScript list), default button
  osascript - "$1" "$TITLE" "$ICON" <<OSA
on run argv
  set theIcon to POSIX file (item 3 of argv)
  display dialog (item 1 of argv) with title (item 2 of argv) buttons $2 default button "$3" with icon theIcon
  return button returned of result
end run
OSA
}

if [ ! -x "$SCRIPT" ]; then
  dialog "$MISSING" "{\"OK\"}" "OK" >/dev/null
  exit 0
fi

CHOICE=$(osascript - "$ASK" "$TITLE" "$ICON" "$CANCEL" "$PURGE" "$KEEP" <<'OSA'
on run argv
  set theIcon to POSIX file (item 3 of argv)
  display dialog (item 1 of argv) with title (item 2 of argv) buttons {item 4 of argv, item 5 of argv, item 6 of argv} default button 3 cancel button 1 with icon theIcon
  return button returned of result
end run
OSA
) || exit 0

ARGS=""
[ "$CHOICE" = "$PURGE" ] && ARGS="--purge"

if OUT=$(osascript -e "do shell script \"'$SCRIPT' $ARGS 2>&1\" with administrator privileges" 2>&1); then
  dialog "$DONE" "{\"OK\"}" "OK" >/dev/null
else
  case "$OUT" in *-128*) exit 0 ;; esac  # password prompt cancelled
  dialog "$FAILED

$OUT" "{\"OK\"}" "OK" >/dev/null
fi
