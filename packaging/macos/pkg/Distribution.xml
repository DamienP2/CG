<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Pulse CG Server</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default"><line choice="com.pulsecg.server"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.pulsecg.server" visible="false">
    <pkg-ref id="com.pulsecg.server"/>
  </choice>
  <pkg-ref id="com.pulsecg.server" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
