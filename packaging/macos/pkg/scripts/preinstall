#!/bin/sh
# Upgrade: stop the running daemon and menu bar app; data is kept.
launchctl bootout system/com.pulsecg.server 2>/dev/null || true
USER_ID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$USER_ID" != "0" ]; then
  launchctl bootout "gui/$USER_ID/com.pulsecg.tray" 2>/dev/null || true
fi
pkill -x pulse-cg-tray 2>/dev/null || true
# Versions up to 0.1.2 installed the app directly in /Applications; before
# the rename to Strata, everything went into /Applications/Pulse CG, then
# /Applications/Strata until the name became Strata Graphics.
rm -rf "/Applications/Pulse CG.app" "/Applications/Pulse CG" "/Applications/Strata"
exit 0
